{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "nestcoworking/modal",
	"title": "Modal",
	"category": "theme",
	"icon": "external",
	"description": "A button that opens its inner content in a native modal dialog.",
	"keywords": [ "dialog", "popup", "lightbox" ],
	"textdomain": "nestcoworking",
	"attributes": {
		"triggerText": {
			"type": "string",
			"default": "Abrir"
		}
	},
	"supports": {
		"interactivity": true,
		"html": false,
		"align": [ "left", "center", "right" ]
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScriptModule": "file:./view.js",
	"render": "file:./render.php"
}
